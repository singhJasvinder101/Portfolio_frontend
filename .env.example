# MongoDB connection string for the blog API
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Public site profile — shown in the hero terminal and about section
NEXT_PUBLIC_SITE_ROLE="Software Engineer"
NEXT_PUBLIC_SITE_COMPANY="Omniful"
NEXT_PUBLIC_SITE_BUILDING="Distributed Systems and Agentic AI Engineering"

# Production URL — required for correct canonical links, sitemap.xml,
# robots.txt and Open Graph/Twitter image URLs. Set this to your real domain.
NEXT_PUBLIC_SITE_URL="jasvindersingh.is-a.dev/"

# Google Analytics 4 Measurement ID (analytics.google.com → Admin → Data streams)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
